# 이 파일을 복사해 `.env.local`을 만들고 값을 채우세요. `.env.local`은 Git에 올라가지 않습니다.

# AI 코스 추천 (BAZE API 게이트웨이)
BAZE_API_KEY=
# 아래 둘은 비워두면 기본값을 씁니다.
# BAZE_BASE_URL=https://api.baze.co/v1/gateway
# BAZE_MODEL=claude-haiku-5-5

# 네이버 로그인 (developers.naver.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 네이버 지도 (네이버 클라우드 플랫폼 Application)
NCP_MAPS_CLIENT_ID=
NCP_MAPS_CLIENT_SECRET=

# 길찾기·장소 이름 검색 (TMAP, openapi.sk.com의 appKey)
TMAP_APP_KEY=

# 장소 한 줄 소개 (NAVER API HUB 블로그 검색)
NAVER_HUB_KEY_ID=
NAVER_HUB_KEY=
# 블로그 검색용 개발자센터 앱이 로그인 앱과 다를 때 (둘 다 비우면 위 로그인 키를 씀)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
