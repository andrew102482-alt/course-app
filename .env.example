# 이 파일을 복사해 `.env.local`을 만들고 값을 채우세요. `.env.local`은 Git에 올라가지 않습니다.

# AI 코스 추천 (BAZE API 게이트웨이)
BAZE_API_KEY=
# 아래 둘은 비워두면 기본값을 씁니다.
# BAZE_BASE_URL=https://api.baze.co/v1/gateway
# BAZE_MODEL=claude-haiku-5-5

# 네이버 로그인 (developers.naver.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 네이버 지도 (네이버 클라우드 플랫폼 Application)
# 지도 화면용 Client ID는 브라우저에 공개되는 값이라 NEXT_PUBLIC_ 이름을 씁니다.
NEXT_PUBLIC_NCP_MAP_CLIENT_ID=
# 장소 검색·길찾기용 Client Secret은 서버에서만 쓰는 비밀 값입니다.
NCP_API_KEY_ID=
NCP_API_KEY=
